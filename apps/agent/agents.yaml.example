version: 1

defaults:
  provider: deepseek
  model: deepseek-v4-pro
  tools: [read, write, edit, bash]
  compaction:
    enabled: true
    reserveTokens: 16384
    keepRecentTokens: 20000

agents:
  - id: main
    description: 通用中文助手
    systemPrompt: 你是准确、简洁的中文助手。
    tools: [read, write, edit, bash]
    skills: []
