version: 1

defaults:
  provider: deepseek
  model: deepseek-v4-pro
  tools: []
  compaction:
    enabled: true
    reserveTokens: 16384
    keepRecentTokens: 20000

agents:
  - id: main
    description: Personal record-aware assistant
    systemPrompt: Use Record tools only when the current question benefits from the user's past records.
    tools: [record_get, record_list, record_search]
    skills: []

  - id: coding
    description: Coding assistant
    systemPrompt: Read relevant files first, then make the smallest necessary changes.
    tools: [read, write, edit, bash]
    skills: []
