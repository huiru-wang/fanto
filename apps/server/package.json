{
  "name": "@fanto/server",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "start": "tsx src/bootstrap/main.ts",
    "typecheck": "tsc --noEmit",
    "test": "tsx --test $(find src -name '*.test.ts' -print)",
    "db:migrate": "tsx src/bootstrap/migrate.ts",
    "seed:creation-showcase": "tsx src/scripts/seed-creation-showcase.ts",
    "memory:rebuild": "tsx ../../scripts/rebuild-memory-index.ts",
    "vector:rebuild": "pnpm memory:rebuild",
    "experiment:pi-proactive": "tsx src/experiments/pi-proactive/run.ts",
    "test:pi-proactive": "tsx --test src/experiments/pi-proactive/*.test.ts"
  },
  "dependencies": {
    "@earendil-works/pi-agent-core": "^0.85.1",
    "@earendil-works/pi-ai": "^0.85.1",
    "@earendil-works/pi-session-backend-sqlite-node": "^0.85.1",
    "@fanto/shared": "workspace:*",
    "@hono/node-server": "^2.1.1",
    "ali-oss": "^6.23.0",
    "better-sqlite3": "^11.9.1",
    "hono": "^4.13.5",
    "kysely": "^0.27.6",
    "sqlite-vec": "^0.1.9",
    "typebox": "^1.3.25",
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "@types/better-sqlite3": "^9.6.0",
    "@types/node": "^22.15.0",
    "tsx": "^4.23.12",
    "typescript": "^5.8.3"
  }
}
