# Server
PORT=3000
HOST=0.0.0.0

# PostgreSQL
DATABASE_URL=postgresql://postgres:replace-with-password@db.example.supabase.co:5432/postgres?sslmode=require&uselibpqcompat=true

# Authentication (replace key material and OAuth client IDs)
AUTH_JWT_ACTIVE_KID=fanto-dev-1
AUTH_JWT_PRIVATE_KEY=-----BEGIN PRIVATE KEY-----\\n...\\n-----END PRIVATE KEY-----
AUTH_JWT_PUBLIC_KEYS={"fanto-dev-1":"-----BEGIN PUBLIC KEY-----\\n...\\n-----END PUBLIC KEY-----"}
AUTH_JWT_ISSUER=fanto
GOOGLE_ALLOWED_CLIENT_IDS=replace-with-google-client-id.apps.googleusercontent.com
APPLE_ALLOWED_CLIENT_IDS=com.robinverse.fanto

# DeepSeek (model selection is configured in agent.yaml)
DEEPSEEK_API_KEY=

# DashScope: record understanding, transcription, and embeddings
DASHSCOPE_API_KEY=
DASHSCOPE_BASE_URL=https://ws-2gkw6cbbhgg7bqz5.cn-beijing.maas.aliyuncs.com/compatible-mode/v1
DASHSCOPE_EMBEDDING_MODEL=qwen3.7-text-embedding-flash
DASHSCOPE_EMBEDDING_DIMENSION=768
DASHSCOPE_VL_MODEL=qwen3-vl-plus
DASHSCOPE_ASR_MODEL=qwen3-asr-flash

# OSS
OSS_REGION=oss-rg-china-mainland
OSS_ENDPOINT=https://oss-rg-china-mainland.aliyuncs.com
OSS_BUCKET=
OSS_ACCESS_KEY_ID=
OSS_ACCESS_KEY_SECRET=

# Agent runtime
AGENT_CONFIG_PATH=apps/server/agent.yaml
AGENT_WORKSPACE_ROOT=data/workspaces

# Shared background Agent queue / Task scheduler
AGENT_EXECUTION_CONCURRENCY=2
TASK_SCHEDULER_INTERVAL_MS=300000
TASK_TIMEOUT_MIN_SECONDS=30
TASK_TIMEOUT_MAX_SECONDS=3600

# Creative Agent pipeline (disabled by default)
CREATIVE_ENABLED=true
CREATIVE_PROPOSAL_TIMEOUT_MS=900000
CREATIVE_CREATOR_TIMEOUT_MS=600000

# Image generation reuses DASHSCOPE_API_KEY by default.
CREATIVE_IMAGE_ENDPOINT=https://ws-2gkw6cbbhgg7bqz5.cn-beijing.maas.aliyuncs.com/api/v1/services/aigc/multimodal-generation/generation
CREATIVE_IMAGE_MODEL=qwen-image-3.0-pro
CREATIVE_IMAGE_TIMEOUT_MS=300000
