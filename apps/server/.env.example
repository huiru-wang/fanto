# LLM Provider
# OpenAI:    set OPENAI_API_KEY=sk-...
# DeepSeek:  set DEEPSEEK_API_KEY=sk-...
PROVIDER=deepseek
MODEL=deepseek-v4-flash

# Database
SQLITE_PATH=../../data/fanto.sqlite

# Server
PORT=3000
HOST=0.0.0.0

# Scheduler
ORGANIZER_TRIGGER_CRON=*/5 * * * *

# Media and Agent
OSS_REGION=oss-cn-hangzhou
# Optional endpoint override. It must be a public endpoint, never a -internal endpoint.
OSS_ENDPOINT=https://oss-cn-hangzhou.aliyuncs.com
OSS_BUCKET=
OSS_ACCESS_KEY_ID=
OSS_ACCESS_KEY_SECRET=
DASHSCOPE_API_KEY=
DASHSCOPE_BASE_URL=https://ws-2gkw6cbbhgg7bqz5.cn-beijing.maas.aliyuncs.com/compatible-mode/v1
DASHSCOPE_EMBEDDING_MODEL=qwen3.7-text-embedding-flash
DASHSCOPE_EMBEDDING_DIMENSION=768
DASHSCOPE_VL_MODEL=qwen3-vl-flash
DASHSCOPE_ASR_MODEL=qwen3-asr-flash
AGENT_WORKSPACE_ROOT=../../data/agent-workspaces
AGENT_SESSION_DATABASE_PATH=../../data/agent-sessions.sqlite
